# echOS Automated Test Script
# Run with: simics.bat targets/echos/auto-test.simics

# Use the HDD UEFI boot target with our custom bootable VHDX image
disable-vmp

$disk0_image = "targets/echos/images/echos-uefi-fixed.vhdx"
$machine_name = "board"
$show_con0 = TRUE
$create_network = FALSE
run-script "targets/qsp-x86/qsp-hdd-boot.simics"

# push COM1 text console to terminal output
board.serconsole.con.enable-cmd-line-output

# reduce model-noise so boot messages are visible
log-type -disable unimpl
log-type -disable spec-viol

echo "=========================================="
echo "echOS Boot Test Starting"
echo "Hard timeout: 60s"
echo "=========================================="

# Safety timeout: stop + quit no matter what
script-branch "timeout-stop" {
    bp.time.wait-for 60
    echo "[auto-test] timeout reached, stopping simulation"
    stop
}

# Start simulation now. timeout-stop branch will terminate it.
run

echo "[auto-test] simulation stopped, collecting CPU state"
board.mb.cpu0.core[0][0].pregs

quit
