$disk0_image = "targets/echos/images/echos-uefi-fixed.vhdx"
$machine_name = "board"
$show_gfx_con = TRUE
$show_con0 = TRUE
run-script "targets/qsp-x86/qsp-hdd-boot.simics"

list-objects substr = frontend
list-objects substr = graph
list-objects substr = console
list-objects substr = gfx

# try showing serial console window explicitly
board.serconsole.con.show

script-branch "end" {
    bp.time.wait-for 5
    stop
    quit
}
run
